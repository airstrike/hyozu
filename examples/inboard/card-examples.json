  {
    "id": "card_leverage",
    "type": "metric",
    "header": { "label": "Leverage" },
    "meta": {
      "description": "Total Debt divided by trailing-twelve-month EBITDA. Primary measure of balance sheet leverage. Revolving credit facility covenant requires Debt/EBITDA below 3.0x. Net Debt variant subtracts unrestricted cash from total debt.",
      "unit": "ratio",
      "tags": ["finance", "leverage", "debt", "covenant", "balance-sheet"],
      "thresholds": [
        { "label": "Covenant limit", "value": 3.0, "direction": "below_is_good" },
        { "label": "Board target", "value": 1.0, "direction": "below_is_good" },
        { "label": "Industry median (SaaS)", "value": 1.8, "direction": "neutral" }
      ]
    },
    "context": { "entity": "Consolidated", "currency": "USD" },
    "selectors": {
      "view": { "options": ["Debt / EBITDA", "Net Debt / EBITDA"], "default": "Debt / EBITDA" }
    },
    "body": {
      "data": [
        {
          "view": "Debt / EBITDA",
          "value": "0.6x",
          "delta": { "display": "-0.1x", "direction": "positive", "period": "vs PQ" },
          "series": [{ "data": [1.1, 1.0, 0.9, 0.85, 0.8, 0.75, 0.7, 0.6], "color": "primary" }]
        },
        {
          "view": "Net Debt / EBITDA",
          "value": "0.4x",
          "delta": { "display": "-0.05x", "direction": "positive", "period": "vs PQ" },
          "series": [{ "data": [0.8, 0.75, 0.7, 0.65, 0.6, 0.55, 0.5, 0.4], "color": "primary" }]
        }
      ],
      "chart": { "type": "line" }
    },
    "footer": {
      "author": { "user_id": "u_josh", "display_name": "Josh Meltzer" },
      "data_source": { "system": "NetSuite GL", "agent": "FP&A Analyst" },
      "updated": "2026-04-05T14:28:00Z"
    },
    "sizing": {
      "default": "small",
      "variants": {
        "small": { "grid": [3, 1], "show": ["value", "delta", "chart"] },
        "wide": { "grid": [6, 1], "show": ["value", "delta", "chart"] }
      }
    },
    "workspace_ref": { "workspace_id": "ws_debt_covenants", "sheet": "Summary", "range": "B47" }
  },

  {
    "id": "card_burn",
    "type": "metric",
    "header": { "label": "Net Burn" },
    "meta": {
      "description": "Monthly net cash burn: total cash outflows minus total cash inflows from operations. Excludes financing activities and one-time items. A decrease in burn rate is positive. At current trajectory ($1.8M/mo) with $32.4M cash on hand, implied runway is ~18 months.",
      "currency": "USD",
      "unit": "currency",
      "magnitude": "millions",
      "tags": ["finance", "treasury", "cash", "burn", "runway"],
      "thresholds": [
        { "label": "Board-approved budget", "value": 2.0, "direction": "below_is_good" },
        { "label": "Breakeven", "value": 0, "direction": "below_is_good" }
      ]
    },
    "context": { "entity": "Consolidated", "period": "Mar 2026" },
    "body": {
      "data": [
        {
          "value": "$1.8M",
          "delta": { "display": "-$200K", "direction": "positive", "period": "vs prior mo" },
          "series": [{ "data": [2.4, 2.3, 2.2, 2.1, 2.0, 2.0, 1.9, 1.8], "color": "success" }]
        }
      ],
      "chart": { "type": "line" }
    },
    "footer": {
      "author": { "user_id": "u_lisa", "display_name": "Lisa Chen" },
      "data_source": { "system": "NetSuite GL", "agent": "Treasury" },
      "updated": "2026-04-05T13:00:00Z"
    },
    "sizing": {
