  {
    "id": "card_revenue",
    "type": "metric",
    "header": { "label": "Revenue" },
    "meta": {
      "description": "GAAP recognized revenue per ASC 606. North America segment only. FY 2026 YTD runs through March. The +12.4% growth is driven primarily by enterprise expansion deals closed in Q4 2025.",
      "currency": "USD",
      "unit": "currency",
      "magnitude": "millions",
      "tags": ["finance", "revenue", "p&l", "north-america", "gaap"],
      "thresholds": [
        { "label": "FY 2026 plan", "value": 105.0, "direction": "above_is_good" },
        { "label": "FY 2025 actual", "value": 91.4, "direction": "above_is_good" }
      ]
    },
    "context": { "region": "North America", "scenario": "Actuals" },
    "selectors": {
      "period": { "options": ["FY 2025", "FY 2026 YTD"], "default": "FY 2026 YTD" }
    },
    "body": {
      "data": [
        {
          "period": "FY 2025",
          "value": "$91.4M",
          "delta": { "display": "+9.1%", "direction": "positive", "period": "vs FY24" },
          "series": [{ "data": [7.0, 7.2, 7.4, 7.3, 7.6, 7.8, 7.5, 7.9, 8.0, 7.7, 8.0, 8.0], "color": "primary" }]
        },
        {
          "period": "FY 2026 YTD",
          "value": "$48.2M",
          "delta": { "display": "+12.4%", "direction": "positive", "period": "YTD vs PY" },
          "series": [{ "data": [6.8, 7.1, 7.4, 7.2, 8.0, 8.6, 9.1], "color": "primary" }]
        }
      ],
      "chart": { "type": "bar" }
    },
    "footer": {
      "author": { "user_id": "u_josh", "display_name": "Josh Meltzer", "email": "josh@acme.com" },
